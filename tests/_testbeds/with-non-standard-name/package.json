{
  "private": true,
  "name": "@cyclonedx/cyclonedx-eslint-testbed-with-non-standard-name/testbed",
  "version": "1.0.0",
  "description": "Example using a name that is non-standard to https://www.npmjs.com/",
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && node dist/bundle.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-esbuild": "file:../../../",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "@cyclonedx/cyclonedx-eslint-testing-custom-package": "file:../../_data/custom-package/package.tgz"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  }
